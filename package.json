{
  "name": "ai-agent",
  "private": true,
  "scripts": {
    "build": "npm run build:sdk && prisma generate && react-router build",
    "prevercel-build": "prisma generate && node scripts/reconcile-durable-catalog-migration.mjs",
    "vercel-build": "prisma migrate deploy && npm run build",
    "migrate:resolve:durable-catalog": "prisma migrate resolve --applied 20260803090000_durable_catalog_sync",
    "build:sdk": "vite build --config storefront-sdk/vite.config.ts",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "test": "vitest run --config vitest.config.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "^7.18.2",
    "@react-router/fs-routes": "^7.18.2",
    "@react-router/node": "^7.18.2",
    "@react-router/serve": "^7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/polaris": "^13.0.0",
    "@shopify/polaris-viz": "^15.0.0",
    "@shopify/shopify-api": "^13.1.0",
    "@shopify/shopify-app-react-router": "^1.2.1",
    "@shopify/shopify-app-session-storage": "^5.0.1",
    "@upstash/redis": "^1.38.0",
    "@vercel/react-router": "^1.3.1",
    "isbot": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.2",
    "recharts": "^2.15.3",
    "vite-tsconfig-paths": "6.0.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^2.0.1",
    "@types/eslint": "^9.6.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.2.0",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.2.4",
    "prisma": "^6.19.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "3.2.4",
    "zod": "^4.4.3"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "@vercel/static-config": {
      "ajv": "8.20.0"
    },
    "esbuild": "0.28.1",
    "lodash": "4.18.1",
    "tar": "7.5.22"
  },
  "author": "PC"
}
